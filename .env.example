# =====================================================================
# Intelligent Brand-Governance Platform (.env.example)
# Team: DoraAIemon | Problem Statement by Inkloom AI
# =====================================================================

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Security & Isolation
SECRET_KEY=change-this-to-a-secure-random-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENABLE_PII_REDACTION=True

# Database (SQLite / Turso connection string)
DATABASE_URL=sqlite:///./brand_governance.db

# AI & LLM Provider Settings
# Multimodal Large Language Model integration (Gemini / Mistral / Adapter)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Model Context Protocol & RAG parameters
RAG_TOP_K=8
STRICT_GROUNDING_REQUIRED=True
MIN_CONFIDENCE_THRESHOLD=0.70

# Static File Uploads Storage Path
STATIC_UPLOAD_DIR=./backend/static/uploads
STATIC_LOGO_DIR=./backend/static/logos
