# Intelligent Brand-Governance Platform environment template

ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1

# Render production values:
# CORS_ORIGINS=https://brand-governance-code-nexu.vercel.app
# TRUSTED_HOSTS=brand-governance-codenexus.onrender.com

SECRET_KEY=generate-a-random-32-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENABLE_PII_REDACTION=True
MAX_UPLOAD_SIZE_MB=100
MCP_REQUESTS_PER_MINUTE=60

# Use the Supabase connection string in Render.
# Keep SQLite locally if you do not have PostgreSQL configured.
DATABASE_URL=postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
VECTOR_SEARCH_ENABLED=True
RAG_TOP_K=8
STRICT_GROUNDING_REQUIRED=True
MIN_CONFIDENCE_THRESHOLD=0.70

STATIC_UPLOAD_DIR=./backend/static/uploads
STATIC_LOGO_DIR=./backend/static/logos
