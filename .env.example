# Intelligent Brand-Governance Platform environment template

ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1

# Render production values:
# CORS_ORIGINS=https://brand-governance-code-nexu.vercel.app
# TRUSTED_HOSTS=brand-governance-codenexus.onrender.com

SECRET_KEY=generate-a-random-32-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENABLE_PII_REDACTION=True
MAX_UPLOAD_SIZE_MB=100
MCP_REQUESTS_PER_MINUTE=60

# PostgreSQL transaction-pooler URI from Supabase Dashboard > Connect.
# Use the exact host and username shown for your project.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Draft media uses a private Supabase Storage bucket in deployment. The backend
# creates a missing bucket as private. Never expose this key to the frontend.
MEDIA_STORAGE_BACKEND=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=draft-media

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
VECTOR_SEARCH_ENABLED=True
RAG_TOP_K=8
STRICT_GROUNDING_REQUIRED=True
MIN_CONFIDENCE_THRESHOLD=0.70

STATIC_UPLOAD_DIR=./backend/static/uploads
STATIC_LOGO_DIR=./backend/static/logos
